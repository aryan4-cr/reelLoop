# ReelLoop local configuration. Copy to .dev.vars and replace blank secrets.
APP_ORIGIN=http://127.0.0.1:5173
PUBLIC_ORIGIN=http://127.0.0.1:8787
META_API_VERSION=v25.0
R2_BUCKET_NAME=reelloop-videos
MAX_STORAGE_BYTES=10737418240
# Generate interactively: node scripts/password.mjs
OWNER_PASSWORD_HASH=
# Generate a 32-byte base64 key locally; keep it for the life of your encrypted tokens.
TOKEN_ENCRYPTION_KEY=
# A separate random secret of at least 32 characters.
MEDIA_SIGNING_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
META_APP_ID=
META_APP_SECRET=
