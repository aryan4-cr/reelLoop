{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reelloop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/media/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "reelloop", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "reelloop-videos" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_ORIGIN": "http://127.0.0.1:5173", "PUBLIC_ORIGIN": "http://127.0.0.1:8787", "META_API_VERSION": "v25.0", "R2_BUCKET_NAME": "reelloop-videos", "MAX_STORAGE_BYTES": "10737418240" },
  "observability": { "enabled": false }
}
