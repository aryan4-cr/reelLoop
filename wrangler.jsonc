{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-worker",
  "account_id": "d0b25c7d1d5d01fe584982892e6a4e94",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "alias": {
    "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reelloop-db",
      "database_id": "289411ef-6f89-40b5-bcaf-69e33dfffb78",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "reelloop-videos" }],
  "triggers": { "crons": [] },
  "vars": {
    "APP_ORIGIN": "https://my-worker.reelloop.workers.dev",
    "PUBLIC_ORIGIN": "https://my-worker.reelloop.workers.dev",
    "META_API_VERSION": "v25.0",
    "R2_BUCKET_NAME": "reelloop-videos",
    "MAX_STORAGE_BYTES": "8000000000",
  },
  "observability": { "enabled": false },
}
